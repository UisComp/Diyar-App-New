# Android Fastfile for Diyar App
# Docs: https://docs.fastlane.tools
#
# Lanes:
#   fastlane android firebase   -> build signed APK and upload to Firebase App Distribution
#   fastlane android playstore  -> build signed AAB and upload to Google Play (internal track)
#   fastlane android beta       -> build + upload to BOTH Firebase and Google Play
#
# All Flutter commands run from the project root (one level above android/).

default_platform(:android)

# Firebase App ID for the Android app (from firebase.json)
FIREBASE_APP_ID = "1:241715939585:android:262b24bc128b7f41f97300"

# Absolute path to the Flutter project root (android/ -> ..)
def flutter_root
  File.expand_path("../..", __dir__)
end

# Run a flutter command from the project root
def flutter(cmd)
  sh("cd #{flutter_root.shellescape} && flutter #{cmd}")
end

platform :android do
  desc "Prepare: fetch packages and run code generation"
  lane :prepare do
    flutter("pub get")
    flutter("pub run build_runner build --delete-conflicting-outputs")
  end

  desc "Build a signed release APK and distribute it to Firebase App Distribution"
  lane :firebase do
    prepare
    flutter("build apk --release")

    firebase_app_distribution(
      app: FIREBASE_APP_ID,
      groups: "testers",
      release_notes: ENV["RELEASE_NOTES"] || "Fastlane build",
      service_credentials_file: ENV["FIREBASE_SERVICE_ACCOUNT_FILE"],
      android_artifact_path: "#{flutter_root}/build/app/outputs/flutter-apk/app-release.apk",
      android_artifact_type: "APK"
    )
  end

  desc "Build a signed release AAB and upload it to Google Play (internal track)"
  lane :playstore do
    prepare
    flutter("build appbundle --release")

    upload_to_play_store(
      track: ENV["PLAY_TRACK"] || "production",
      aab: "#{flutter_root}/build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["PLAY_JSON_KEY_FILE"] || "fastlane/play-service-account.json",
      # "completed" = roll out to 100% of the chosen track once Google review passes.
      release_status: ENV["PLAY_RELEASE_STATUS"] || "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Distribute to BOTH Firebase App Distribution and Google Play"
  lane :beta do
    firebase
    playstore
  end
end
